# Copy to .env.local for local development. Never commit real values.
# In production, set these in Vercel → Project → Settings → Environment Variables.

# --- Site ---------------------------------------------------------------
# Canonical URL used for metadata, sitemap, RSS and JSON-LD. No trailing slash.
NEXT_PUBLIC_SITE_URL=https://www.amarkumar.dev

# --- Contact form (Resend) ----------------------------------------------
# Without these the form shows a friendly "email me directly" fallback.
RESEND_API_KEY=
CONTACT_TO_EMAIL=amar.kumar.career@gmail.com
# Must be a sender on a domain verified in Resend (onboarding@resend.dev works for testing).
CONTACT_FROM_EMAIL=Amar Kumar <onboarding@resend.dev>

# --- Admin login ---------------------------------------------------------
# Single admin user.
ADMIN_USERNAME=
# bcrypt hash from: node scripts/hash-password.mjs "your password"
# In .env.local, escape every $ as \$ (the script prints both forms). In Vercel, paste it as-is.
ADMIN_PASSWORD_HASH=
# Random secret of at least 32 characters, used to sign session cookies.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
ADMIN_SESSION_SECRET=

# --- Publishing (GitHub) ---------------------------------------------------
# Fine-grained token scoped to Amarkumar30/portfolio_ only, with "Contents: Read and write".
# Leave empty in local development to write files straight to your working tree instead.
GITHUB_TOKEN=
GITHUB_OWNER=Amarkumar30
GITHUB_REPO=portfolio_
# Commits to this branch trigger the Vercel production deploy.
GITHUB_BRANCH=main
